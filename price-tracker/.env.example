# Copy this file to .env and fill in whichever integrations you want.
# Every setting is optional -- anything left blank just falls back to a
# local/offline default (see README.md).

# --- Storage ---------------------------------------------------------------
# Leave blank to use the built-in local JSON store at data/store.json.
MONGO_URI=
MONGO_DB_NAME=price_tracker

# --- Scheduler / scraping politeness ----------------------------------------
SCRAPE_INTERVAL_MINUTES=30
REQUEST_TIMEOUT_SECONDS=15
MIN_DELAY_SECONDS=2
MAX_DELAY_SECONDS=6
MAX_RETRIES=3

# --- Telegram alerts ---------------------------------------------------------
# 1. Message @BotFather on Telegram, /newbot, copy the token it gives you.
# 2. Message your new bot once, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email alerts (used only if Telegram isn't configured, or as backup) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Queue (optional) ---------------------------------------------------------
# Set to enable distributed checking with `rq worker scrape`. Needs MongoDB.
REDIS_URL=
SCRAPE_CONCURRENCY=4
PER_DOMAIN_MIN_INTERVAL_SECONDS=5

# --- API ----------------------------------------------------------------------
# Optional shared secret for write endpoints; the Chrome extension sends it as
# X-API-Token. Set it whenever the API is reachable from outside your machine.
API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
